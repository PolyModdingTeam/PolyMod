{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "../resources",
        "files": [
          "polymod_icon.png"
        ],
        "dest": "images"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "PolyMod",
      "_appTitle": "PolyMod",
      "_appLogoPath": "images/polymod_icon.png",
      "_appFaviconPath": "images/polymod_icon.png",
      "_enableSearch": true,
      "pdf": false
    }
  }
}